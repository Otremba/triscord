{
  "name": "triscord-cloudflare-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir out",
    "test": "npm run build && node tests/auth.test.mjs && node tests/password.test.mjs && node tests/media.test.mjs && node tests/migration-plan.test.mjs",
    "db:plan": "node scripts/migrate.mjs --remote",
    "db:migrate": "node scripts/migrate.mjs --remote --apply",
    "test:remote": "node tests/remote-readiness.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  }
}
