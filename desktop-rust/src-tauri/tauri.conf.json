{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Triscord Rust Preview",
  "version": "0.1.0",
  "identifier": "app.triscord.rust-preview",
  "build": { "frontendDist": "../../desktop/web/dist-rust" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Triscord Rust Preview", "width": 1200, "height": 800, "minWidth": 850, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [{ "identifier": "main-window", "windows": ["main"], "permissions": ["core:event:default"] }]
    }
  },
  "bundle": { "active": false, "icon": ["../../desktop/assets/triscord-app.ico"] }
}
