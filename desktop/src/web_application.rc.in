// Windows resources of the WebView2 client (triscord-web.exe): the app icon (assets/triscord-app.ico: the white logo on
// the update splash grey #282b30, user request 18/10) (id 1, used by the notifier, and Qt's
// IDI_ICON1, the default window icon) and the version block Windows shows as the process and taskbar name.
#include <winver.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/triscord-app.ico"
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/triscord-app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604b0"
    BEGIN
      VALUE "CompanyName", "Triscord"
      VALUE "FileDescription", "Triscord"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "Triscord"
      VALUE "OriginalFilename", "triscord-web.exe"
      VALUE "ProductName", "Triscord"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
