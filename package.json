{
  "name": "triscord",
  "version": "1.0.0",
  "description": "Triscord - Voice, Video & Screen Sharing Desktop Application with Electron and WebRTC",
  "main": "src/main.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run electron\"",
    "electron": "electron .",
    "server": "node server/server.js",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "triscord",
    "electron",
    "webrtc",
    "voice-chat",
    "discord-clone",
    "screen-sharing"
  ],
  "author": "Otremba",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.otremba.triscord",
    "productName": "Triscord",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "server/**/*",
      "package.json",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icon.ico",
      "artifactName": "Triscord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Triscord"
    }
  }
}
